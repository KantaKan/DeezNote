# SQLite database file (created on first start). Defaults to apps/api/data/deeznote.db
# DATABASE_PATH=/var/lib/deeznote/deeznote.db
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Security defaults (bytes; rate limits are per IP unless noted).
# API_MAX_BODY_BYTES=8388608
# API_MAX_AUTH_BODY_BYTES=4096
# API_MAX_HEADER_BYTES=16384
# API_MAX_HEADER_VALUE_BYTES=8192
# API_REQUESTS_PER_MINUTE=120
# API_AUTH_PER_MINUTE=10
# API_REGISTRATIONS_PER_HOUR=5
# API_LOGINS_PER_ACCOUNT_WINDOW=20
# API_MAX_CONCURRENT_HASHES=2
# API_MAX_RATE_LIMIT_KEYS=10000
# Socket-peer IPs (or IPv4 ranges like 172.16.0.0/12) of your reverse proxy, comma-separated; empty = trust none.
# Never put public client IPs here. Keep the API inaccessible from the internet.
# API_TRUSTED_PROXY_IPS=172.18.0.2
