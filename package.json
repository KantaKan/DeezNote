{
  "name": "deeznote",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npx --yes bun@1.4.2 run --cwd apps/api dev\" \"npx --yes bun@1.4.2 run --cwd apps/web dev\"",
    "test": "npx --yes bun@1.4.2 test",
    "test:watch": "npx --yes bun@1.4.2 test --watch",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --cwd apps/api db:generate"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
