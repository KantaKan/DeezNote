{
  "name": "@save-text/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
